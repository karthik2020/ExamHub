# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Auth configuration
SUPABASE_URL="https://bxeyafzvqncqggfehlge.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Commercial Payment & Webhook Configuration (Phase 4B Sandbox Mode)
# Server-only secrets - NEVER prefix with VITE_ or expose to client
PAYMENT_PROVIDER="PADDLE"
PAYMENT_PROVIDER_MODE="sandbox"
PADDLE_API_KEY="paddlesandbox_api_key_placeholder"
PADDLE_WEBHOOK_SECRET="paddlesandbox_whsec_placeholder"
PADDLE_ENVIRONMENT="sandbox"

